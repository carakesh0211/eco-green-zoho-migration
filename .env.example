# ---- Eco Green -> Zoho Books migration pilot: environment template ----
# Copy to .env and fill locally. NEVER commit .env. Values below are placeholders only.

# Runtime
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Store adapter: sqlite (local, node:sqlite) | catalyst (Data Store; not wired in MVP)
STORE_ADAPTER=sqlite
SQLITE_PATH=./var/migration.db

# Inbox adapter: local (folder polling) | workdrive (stub until credentials are supplied)
INBOX_ADAPTER=local
INBOX_LOCAL_PATH=./var/inbox
WORKDRIVE_FOLDER_ID=
WORKDRIVE_CLIENT_ID=
WORKDRIVE_CLIENT_SECRET=
WORKDRIVE_REFRESH_TOKEN=

# Archive adapter: local (immutable folder) | stratus (Catalyst Stratus; not wired in MVP)
ARCHIVE_ADAPTER=local
ARCHIVE_LOCAL_PATH=./var/archive
STRATUS_BUCKET=

# Zoho Books target
# driver: mock (default, offline) | live (READ-ONLY baseline/report retrieval in MVP)
BOOKS_DRIVER=mock
BOOKS_API_BASE=https://www.zohoapis.in/books/v3
BOOKS_ACCOUNTS_BASE=https://accounts.zoho.in
BOOKS_CLIENT_ID=
BOOKS_CLIENT_SECRET=
BOOKS_REFRESH_TOKEN=
# The single organisation this deployment targets, and the allowlist it must also appear in. Empty = no live calls.
BOOKS_ORGANIZATION_ID=
# Comma-separated organisation IDs this deployment is ALLOWED to talk to. Empty = none.
BOOKS_ORG_ALLOWLIST=
# Production posting is disabled by default and requires BOTH flags plus an allowlisted org.
POSTING_ENABLED=false
POSTING_AUTHORIZATION_REF=
# Organisation-wide throttle shared by all locations
BOOKS_RATE_LIMIT_PER_MINUTE=100
BOOKS_MAX_CONCURRENCY=2
BOOKS_REQUEST_TIMEOUT_MS=30000
BOOKS_MAX_ATTEMPTS=5

# Security
APP_ENCRYPTION_KEY=              # 32-byte base64; encrypts stored OAuth tokens
JWT_SECRET=                      # required in production
USERS_CONFIG_PATH=./config/users.local.json

# Worker
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=5000
WORKER_CLAIM_TTL_MS=600000

# Migration defaults
MIGRATION_FROM_DATE=2026-04-01
DEFAULT_CURRENCY=INR
