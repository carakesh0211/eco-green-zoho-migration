# ---- Eco Green -> Zoho Books migration pilot: environment template ----
# Copy to .env and fill locally. NEVER commit .env. Values below are placeholders only.

# Runtime
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Store adapter: sqlite (local, node:sqlite) | catalyst (Catalyst Data Store, AppSail)
STORE_ADAPTER=sqlite
SQLITE_PATH=./var/migration.db

# Inbox adapter: local (folder polling) | bundled (read-only fixtures/synthetic/*, used
# ONLY by the Development seed endpoint) | workdrive (stub until credentials are supplied)
INBOX_ADAPTER=local
INBOX_LOCAL_PATH=./var/inbox
WORKDRIVE_FOLDER_ID=
WORKDRIVE_CLIENT_ID=
WORKDRIVE_CLIENT_SECRET=
WORKDRIVE_REFRESH_TOKEN=

# Archive adapter: local (immutable folder) | stratus (Catalyst Stratus) | disabled
# (Development only — no bytes are ever stored; refuses to select in Production)
ARCHIVE_ADAPTER=local
ARCHIVE_LOCAL_PATH=./var/archive
STRATUS_BUCKET=

# Zoho Books target
# driver: mock (default, offline) | live (READ-ONLY baseline/report retrieval in MVP)
BOOKS_DRIVER=mock
BOOKS_API_BASE=https://www.zohoapis.in/books/v3
BOOKS_ACCOUNTS_BASE=https://accounts.zoho.in
BOOKS_CLIENT_ID=
BOOKS_CLIENT_SECRET=
BOOKS_REFRESH_TOKEN=
# The single organisation this deployment targets, and the allowlist it must also appear in. Empty = no live calls.
BOOKS_ORGANIZATION_ID=
# Comma-separated organisation IDs this deployment is ALLOWED to talk to. Empty = none.
BOOKS_ORG_ALLOWLIST=
# Production posting is disabled by default and requires BOTH flags plus an allowlisted org.
POSTING_ENABLED=false
POSTING_AUTHORIZATION_REF=
# Organisation-wide throttle shared by all locations
BOOKS_RATE_LIMIT_PER_MINUTE=100
BOOKS_MAX_CONCURRENCY=2
BOOKS_REQUEST_TIMEOUT_MS=30000
BOOKS_MAX_ATTEMPTS=5

# Security
APP_ENCRYPTION_KEY=              # 32-byte base64; encrypts stored OAuth tokens
JWT_SECRET=                      # required in production
USERS_CONFIG_PATH=./config/users.local.json
# Inline JSON users list, preferred over USERS_CONFIG_PATH in deployed environments that
# have no mountable/writable config file (e.g. an AppSail env var holding the whole list).
# Same shape as config/users.example.json. Takes precedence over USERS_CONFIG_PATH when set.
USERS_CONFIG_JSON=

# Worker (this MVP's dashboard does NOT run the worker loop by default — the Development
# seed endpoint drives the pipeline stages in-process instead; see src/server/routes/dev.js)
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=5000
WORKER_CLAIM_TTL_MS=600000
# disabled (default; deployed config) | singleton (required to run `npm run worker` at all
# against STORE_ADAPTER=catalyst — its best-effort, non-atomic claim()/releaseClaim() means
# more than one worker instance risks double-claiming the same queue item)
WORKER_MODE=disabled
# Best-effort mutual-exclusion lease window (ms) for WORKER_MODE=singleton — see
# src/worker/index.js#findConflictingSingletonLease.
WORKER_LEASE_MS=600000

# Migration defaults
MIGRATION_FROM_DATE=2026-04-01
DEFAULT_CURRENCY=INR

# Catalyst AppSail runtime (docs/CATALYST_REFERENCES.md). X_ZOHO_CATALYST_LISTEN_PORT and
# X_ZOHO_CATALYST_ENVIRONMENT are PROVIDED BY THE APPSAIL RUNTIME ITSELF — never set them
# by hand outside Catalyst; PORT/CATALYST_ENVIRONMENT below are the local-dev fallbacks.
X_ZOHO_CATALYST_LISTEN_PORT=
# AppSail rejects env names with the CATALYST_ prefix (reserved); use APP_ENVIRONMENT in deployed config.
APP_ENVIRONMENT=
X_ZOHO_CATALYST_ENVIRONMENT=
# Local-dev fallback for the environment name when not running on AppSail: 'Development' |
# 'Production' | 'local' (default). GET /api/health reports this as `environment`.
CATALYST_ENVIRONMENT=local

# Development-only synthetic seed endpoint (POST /api/dev/seed). Refused unless BOTH this
# is 'true' AND the resolved environment is exactly 'Development' — never in Production.
DEV_SEED_ENABLED=false

# Optional build identifier surfaced verbatim on GET /api/health as `buildSha` (e.g. set by
# CI to the git commit sha at build time). Omit/leave blank to report `null`.
BUILD_SHA=
